APP_NAME="ERP PRO"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erpro
DB_DATABASE_COMMON=erpro_common
DB_USERNAME=root
DB_PASSWORD=

# Default DB credentials for new users (used when creating users without custom DB settings)
DB_DEFAULT_USERNAME=root
DB_DEFAULT_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
# Use "file" unless the DB is always up; "database" sessions require a working DB on every request.
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Leave empty so the cookie matches the current host (e.g. public.test). Wrong domain → 419.
SESSION_DOMAIN=
# Must be false when using http:// (otherwise the session cookie is not stored → 419 Page Expired).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Laravel Telescope (Dev Only - set to false in production)
TELESCOPE_ENABLED=true

# Laravel Debugbar (Dev Only - set to false in production)
DEBUGBAR_ENABLED=true

# ===============================================
# ERP PRO SPECIFIC SETTINGS
# ===============================================

# Company Settings
COMPANY_NAME="Your Company Name"
COMPANY_NAME_AR="اسم شركتك"
COMPANY_ADDRESS="Company Address"
COMPANY_PHONE="+966 XX XXX XXXX"
COMPANY_EMAIL="info@yourcompany.com"
COMPANY_TAX_NUMBER="Tax ID / VAT Number"
COMPANY_CR_NUMBER="Commercial Registration Number"

# Localization Settings
DEFAULT_CURRENCY=SAR
DEFAULT_LOCALE=en
DEFAULT_TIMEZONE=Asia/Riyadh
FISCAL_YEAR_START=01-01

# Inventory Settings
INVENTORY_VALUATION_METHOD=fifo
# Options: fifo, lifo, weighted_average

ALLOW_NEGATIVE_STOCK=false
AUTO_GENERATE_CODES=false
# Set to false - Manual entry now enforced

# Financial Settings
FISCAL_PERIOD_LOCK=false
DEFAULT_PAYMENT_TERMS=credit_30
# Options: cash, credit_7, credit_15, credit_30, credit_60, credit_90

# Document Numbering (Manual Entry)
# These are just prefixes if you want to suggest formats
INVOICE_PREFIX=INV-
PURCHASE_ORDER_PREFIX=PO-
SALES_ORDER_PREFIX=SO-
QUOTATION_PREFIX=QT-

# Decimal Places
DECIMAL_QUANTITY=2
DECIMAL_PRICE=2
DECIMAL_AMOUNT=2

# Tax Settings
DEFAULT_TAX_RATE=15
# Saudi VAT rate: 15%

ENABLE_TAX_INCLUSIVE=false
# If true, prices include tax; if false, tax is added on top

# Reporting Settings
DEFAULT_DATE_FORMAT=Y-m-d
DEFAULT_TIME_FORMAT=H:i:s
DEFAULT_DATETIME_FORMAT=Y-m-d H:i:s

# File Upload Settings
MAX_UPLOAD_SIZE=10240
# Maximum file size in KB (10MB)

ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx,xls,xlsx

# Session & Security (SESSION_* defaults are near the top of this file)
# Set SESSION_SECURE_COOKIE=true only behind HTTPS in production.

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,public.test

# Performance & Caching
CACHE_QUERY_RESULTS=true
CACHE_TTL=3600
# Cache time-to-live in seconds (1 hour)

# Backup Settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=daily
# Options: daily, weekly, monthly

BACKUP_RETENTION_DAYS=30

# Multi-Language Support
SUPPORTED_LOCALES=en,ar
FALLBACK_LOCALE=en

# Email Notifications
ENABLE_EMAIL_NOTIFICATIONS=true
NOTIFY_ON_INVOICE_CREATED=true
NOTIFY_ON_ORDER_PLACED=true
NOTIFY_ON_PAYMENT_RECEIVED=true

# Audit Trail
ENABLE_AUDIT_LOG=true
AUDIT_RETENTION_DAYS=365

# API Settings (if you add API endpoints)
API_RATE_LIMIT=60
# Requests per minute

API_ENABLE_CORS=false
